  },
  "license": "MIT",
  "dependencies": {
    "smqp": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@types/node": "^20.19.40",
    "amqplib": "^1.2.0",
    "c8": "^11.0.0",
    "chai": "^6.2.1",
    "eslint": "^10.3.0",
    "globals": "^17.0.0",
    "mocha": "^11.0.1",
    "prettier": "^3.2.5",
    "quibble": "^0.9.2",
